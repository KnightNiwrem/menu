{
    "lock": false,
    "tasks": {
        "ok": "deno fmt --check && deno lint && deno task check && deno task test",
        "check": "deno check --allow-import",
        "test": "deno test --allow-import tests/"
    },
    "fmt": {
        "indentWidth": 4,
        "proseWrap": "preserve"
    },
    "exclude": ["./node_modules/", "./out/", "./package-lock.json"]
}
